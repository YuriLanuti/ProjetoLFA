<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.projetolfa.erController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>
    <Label text="EXPRESSÃO REGULAR"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <VBox spacing="8.0" prefWidth="650.0">
        <Label text="Expressão:"/>
        <TextField fx:id="campoExpressao" promptText="Ex: (a|b).(a|b).(a|b)"/>
    </VBox>
    <VBox spacing="8.0" prefWidth="650.0">
        <Label text="Palavras para testar:" style="-fx-font-size: 14px;"/>
        <TextArea fx:id="campoPalavras" prefRowCount="5" wrapText="true" promptText="Digite uma palavra por linha"/>
    </VBox>
    <HBox alignment="CENTER" spacing="15.0">
        <Button text="TESTAR" onAction="#testarExpressao"/>
        <Button text="LIMPAR" onAction="#limparCampos"/>
    </HBox>
    <VBox spacing="8.0" prefWidth="650.0">
        <Label text="Resultado:" style="-fx-font-size: 14px;"/>
        <TextArea fx:id="resultado" editable="false" prefRowCount="6" wrapText="true"/>
    </VBox>
</VBox>