<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetolfa.erController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
   <children>
       <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="EXPRESSÃO REGULAR" />
       <VBox prefWidth="650.0" spacing="8.0">
          <children>
              <Label text="Expressão:" />
              <TextField fx:id="campoExpressao" promptText="Ex: (a|b).(a|b).(a|b)" />
          </children>
       </VBox>
       <VBox prefWidth="650.0" spacing="8.0">
          <children>
              <Label style="-fx-font-size: 14px;" text="Palavras para testar:" />
              <TextArea fx:id="campoPalavras" prefRowCount="5" promptText="Digite uma entrada por linha" wrapText="true" />
          </children>
       </VBox>
       <HBox alignment="CENTER" spacing="15.0">
          <children>
              <Button onAction="#testarExpressao" text="TESTAR" />
              <Button onAction="#limparCampos" text="LIMPAR" />
          </children>
       </HBox>
       <VBox prefWidth="650.0" spacing="8.0">
          <children>
              <Label style="-fx-font-size: 14px;" text="Resultado:" />
              <TextArea fx:id="resultado" editable="false" prefRowCount="6" wrapText="true" />
          </children>
       </VBox>
   </children>
</VBox>
